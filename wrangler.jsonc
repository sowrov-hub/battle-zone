{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "battle-zone",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "battle-zone-db",
      "database_id": "52ef127d-1814-4cc3-a7f8-2577cef21d31"
    }
  ],
  "observability": { "enabled": true }
}
